# Supabase — https://supabase.com/dashboard/project/_/settings/api
# EXPO_PUBLIC_ 접두사가 있어야 번들에 포함된다. 없으면 런타임에 undefined가 된다.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# 로그인 아이디는 환경 변수가 아니다 — 앱이 <아이디>@meepick.local로 변환해 인증한다.
# 공용 계정 생성 규칙은 SUPABASE_SETUP.md 7-1 참고. 비밀번호는 어디에도 적지 않는다.

# ── 로컬 관리 스크립트 전용 ────────────────────────────────────────────────
# EXPO_PUBLIC_ 접두사가 없으므로 앱 번들에 포함되지 않는다. 절대 접두사를 붙이지 말 것.
# 대시보드 → Project Settings → API 의 service_role(또는 sb_secret_...) 키.
# scripts/upload-images.mjs 가 표지 이미지를 올릴 때만 쓴다.
SUPABASE_SECRET_KEY=
